# Copy to .env and fill in. Only the IMAP/SMTP settings are required to run the email agent.

# --- Mailbox the agent watches (Gmail shown; use an App Password, not your normal password) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-agent-inbox@gmail.com
IMAP_PASSWORD=your-16-character-app-password
IMAP_FOLDER=INBOX

SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS; any other port uses STARTTLS
SMTP_PORT=465
# SMTP_USER / SMTP_PASSWORD default to the IMAP credentials
# AGENT_EMAIL defaults to IMAP_USER
AGENT_NAME=UARB Regulatory Agent

# Optional: only answer these senders (comma-separated). Empty = answer anyone.
ALLOWED_SENDERS=
POLL_INTERVAL_SECONDS=30

# --- Claude reads free-form requests. Without a key the agent uses keyword rules. ---
ANTHROPIC_API_KEY=
# USE_LLM=true|false (default: true when ANTHROPIC_API_KEY is set)
CLAUDE_MODEL=claude-opus-5-5

# --- Scraping and packaging ---
MAX_DOCUMENTS=10
# Gmail rejects messages over 25 MB; base64 adds ~37%, so 18 MB of files is the safe ceiling.
MAX_ATTACHMENT_MB=18
HEADLESS=true
# Visible, screen-sized, slowed-down browser for recording a demo (same as the --demo flag)
DEMO_MODE=false
# Where `python -m uarb_agent ask` saves the ZIP
OUTPUT_DIR=output
# Searchable record of every matter and document fetched (empty = search off)
INDEX_PATH=data/uarb_index.sqlite3
